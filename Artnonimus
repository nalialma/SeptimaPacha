<meta name="theme-color" content="#15110D">

<!-- =====================================================================
     FUENTES (Google Fonts): 
     - Fraunces  -> tipografía de exhibición (titulares, con cursiva artística)
     - Outfit    -> tipografía de cuerpo (texto general, UI)
     - JetBrains Mono -> tipografía de "placa de museo" (etiquetas, datos, nav)
     ===================================================================== -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<!-- =====================================================================
     TAILWIND CSS (embebido vía CDN — sin build step, sin librerías pesadas)
     ===================================================================== -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  // ---------------------------------------------------------------------
  // CONFIGURACIÓN DE TAILWIND — Paleta y tipografías propias del estudio.
  // Edita aquí los colores de marca si quieres cambiar la identidad visual.
  // ---------------------------------------------------------------------
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          bg:        '#15110D', // fondo principal — "pared de galería" casi negra y cálida
          panel:     '#1E1812', // fondo de tarjetas / paneles
          frame:     '#2A2118', // bordes, líneas divisorias (marco de madera envejecida)
          gold:      '#C9A24B', // acento principal — hoja de oro / latón
          goldlight: '#E3C572', // acento claro — hover / brillo
          rust:      '#B8542E', // acento secundario — terracota cálida
          bone:      '#F1E8D9', // texto principal sobre fondo oscuro
          bonedim:   '#B9AC97', // texto secundario / atenuado
        },
        fontFamily: {
          display: ['"Fraunces"', 'serif'],
          body:    ['"Outfit"', 'sans-serif'],
          mono:    ['"JetBrains Mono"', 'monospace'],
        },
        boxShadow: {
          gold: '0 0 0 1px rgba(201,162,75,0.35)',
        }
      }
    }
  }
</script>

<style>
  /* =====================================================================
     ESTILOS BASE Y VARIABLES
     ===================================================================== */
  :root{
    --mx: 50%; /* posición X del cursor, usada en el resplandor del hero */
    --my: 35%; /* posición Y del cursor */
    --header-h: 84px;
  }
  html{ scroll-behavior: smooth; }
  body{
    background-color:#15110D;
    font-family:'Outfit', sans-serif;
    overscroll-behavior-y: none;
  }
  /* Compensa el header fijo al hacer scroll a una sección por ancla */
  section[id]{ scroll-margin-top: var(--header-h); }

  /* Texturiza el fondo como un lienzo / pared de galería (ruido sutil en SVG, muy ligero) */
  .canvas-texture{
    position:fixed; inset:0; z-index:1; pointer-events:none;
    opacity:.05; mix-blend-mode:overlay;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }

  /* =====================================================================
     SPLASH SCREEN — animación de bienvenida
     ===================================================================== */
  #splash{
    position:fixed; inset:0; z-index:100;
    display:flex; align-items:center; justify-content:center;
    background: radial-gradient(circle at 50% 40%, #221a12 0%, #120e0a 70%, #0c0a08 100%);
    transition: opacity .9s ease, visibility .9s ease;
  }
  #splash.splash-hide{ opacity:0; visibility:hidden; pointer-events:none; }
  body.no-scroll{ overflow:hidden; height:100%; }

  .splash-ring{
    position:absolute; border-radius:9999px; border:1px solid rgba(201,162,75,.35);
    animation: splashRing 2.6s ease-out infinite;
  }
  .splash-ring.r2{ animation-delay:.7s; }
  .splash-ring.r3{ animation-delay:1.4s; }
  @keyframes splashRing{
    0%{ width:90px; height:90px; opacity:.7; }
    100%{ width:260px; height:260px; opacity:0; }
  }
  .splash-logo{ animation: splashPulse 2.4s ease-in-out infinite; }
  @keyframes splashPulse{
    0%,100%{ transform:scale(.96); box-shadow:0 0 0 0 rgba(201,162,75,.0); }
    50%{ transform:scale(1.03); box-shadow:0 0 40px 6px rgba(201,162,75,.18); }
  }
  .splash-dot{ animation: splashDots 1.3s ease-in-out infinite; }
  .splash-dot:nth-child(2){ animation-delay:.15s; }
  .splash-dot:nth-child(3){ animation-delay:.3s; }
  @keyframes splashDots{ 0%,80%,100%{ opacity:.25; transform:translateY(0);} 40%{ opacity:1; transform:translateY(-3px);} }

  /* =====================================================================
     CABECERA (HEADER)
     ===================================================================== */
  #site-header{ height:var(--header-h); transition: background-color .4s ease, border-color .4s ease, height .4s ease; }
  #site-header.scrolled{ background-color: rgba(21,17,13,.86); backdrop-filter: blur(10px); border-bottom:1px solid rgba(201,162,75,.18); }
  #site-header:not(.scrolled){ border-bottom:1px solid transparent; }

  .nav-link{ position:relative; color:#B9AC97; }
  .nav-link::after{
    content:''; position:absolute; left:0; right:0; bottom:-6px; height:1px;
    background:#C9A24B; transform:scaleX(0); transform-origin:left; transition:transform .35s ease;
  }
  .nav-link:hover{ color:#F1E8D9; }
  .nav-link:hover::after{ transform:scaleX(1); }
  .nav-link.is-active{ color:#E3C572; }

  /* Selector de idioma */
  .lang-pill{ color:#B9AC97; border:1px solid rgba(185,172,151,.25); transition:all .25s ease; }
  .lang-pill:hover{ color:#F1E8D9; border-color:rgba(201,162,75,.5); }
  .lang-pill.is-active{ color:#15110D; background:#C9A24B; border-color:#C9A24B; }

  /* Botón dorado relleno (CTA principal) */
  .btn-gold{
    background:#C9A24B; color:#15110D; transition: transform .3s cubic-bezier(.16,1,.3,1), background-color .3s ease, box-shadow .3s ease;
  }
  .btn-gold:hover{ background:#E3C572; transform:translateY(-2px); box-shadow:0 12px 28px -10px rgba(201,162,75,.55); }
  .btn-gold:active{ transform:translateY(0); }

  /* Botón contorno dorado (CTA secundario) */
  .btn-outline{
    border:1px solid rgba(201,162,75,.55); color:#F1E8D9; transition: all .3s ease;
  }
  .btn-outline:hover{ border-color:#E3C572; background:rgba(201,162,75,.08); transform:translateY(-2px); }

  /* =====================================================================
     MENÚ MÓVIL
     ===================================================================== */
  #mobile-nav{ transition: opacity .45s ease, visibility .45s ease; }
  #mobile-nav.is-open{ opacity:1; visibility:visible; }
  #mobile-nav:not(.is-open){ opacity:0; visibility:hidden; }
  #mobile-nav .mnav-link{ opacity:0; transform:translateY(14px); transition:opacity .5s ease, transform .5s ease; }
  #mobile-nav.is-open .mnav-link{ opacity:1; transform:translateY(0); }

  /* =====================================================================
     HERO — resplandor tipo foco de galería que sigue al cursor
     ===================================================================== */
  .hero-spotlight{
    background: radial-gradient(560px circle at var(--mx) var(--my), rgba(201,162,75,.16), transparent 60%);
  }
  .hero-frame{ animation: floatY 6s ease-in-out infinite; will-change:transform; }
  @keyframes floatY{ 0%,100%{ transform:translateY(0) rotate(-1.2deg);} 50%{ transform:translateY(-14px) rotate(.6deg);} }

  /* Marquesina de técnicas (desplazamiento infinito en CSS puro) */
  .marquee-track{ animation: marquee 28s linear infinite; }
  .marquee-track:hover{ animation-play-state: paused; }
  @keyframes marquee{ from{ transform:translateX(0);} to{ transform:translateX(-50%);} }

  /* =====================================================================
     "ESQUINAS DE MARCO" — elemento firma del diseño.
     Simula la esquina de un cuadro enmarcado en oro, como en una galería.
     Se usa en el hero, en las tarjetas de obras y en el lightbox.
     ===================================================================== */
  .frame-corners{ position:relative; }
  .frame-corners::before,
  .frame-corners::after,
  .frame-corners .fc-tr,
  .frame-corners .fc-bl{
    content:''; position:absolute; width:22px; height:22px; pointer-events:none; z-index:2;
    transition: width .35s ease, height .35s ease, opacity .35s ease;
  }
  .frame-corners::before{ top:8px; left:8px; border-top:2px solid #C9A24B; border-left:2px solid #C9A24B; }
  .frame-corners::after{ bottom:8px; right:8px; border-bottom:2px solid #C9A24B; border-right:2px solid #C9A24B; }
  .frame-corners .fc-tr{ top:8px; right:8px; border-top:2px solid #C9A24B; border-right:2px solid #C9A24B; }
  .frame-corners .fc-bl{ bottom:8px; left:8px; border-bottom:2px solid #C9A24B; border-left:2px solid #C9A24B; }
  .frame-corners:hover::before, .frame-corners:hover::after,
  .frame-corners:hover .fc-tr, .frame-corners:hover .fc-bl{ width:30px; height:30px; }

  /* =====================================================================
     SECCIONES CON "REVELADO" AL HACER SCROLL (IntersectionObserver)
     ===================================================================== */
  .reveal{ opacity:0; transform:translateY(28px); transition:opacity .85s cubic-bezier(.16,1,.3,1), transform .85s cubic-bezier(.16,1,.3,1); }
  .reveal.is-visible{ opacity:1; transform:translateY(0); }

  /* =====================================================================
     GALERÍA — disposición tipo "masonry" con columnas CSS (sin librerías)
     ===================================================================== */
  .masonry{ column-count:1; column-gap:1.25rem; }
  @media(min-width:640px){ .masonry{ column-count:2; } }
  @media(min-width:1024px){ .masonry{ column-count:3; } }
  .masonry-item{ break-inside:avoid; margin-bottom:1.25rem; }
  .masonry-item.is-hidden{ display:none; }
  .masonry-item img{ transition: transform .7s cubic-bezier(.16,1,.3,1); }
  .masonry-item:hover img{ transform:scale(1.045); }

  .gallery-overlay{ background:linear-gradient(180deg, rgba(21,17,13,0) 35%, rgba(21,17,13,.92) 100%); opacity:0; transition:opacity .4s ease; }
  .masonry-item:hover .gallery-overlay, .masonry-item:focus-within .gallery-overlay{ opacity:1; }
  .gallery-overlay-btn{ transform:translateY(10px); opacity:0; transition: all .4s ease .05s; }
  .masonry-item:hover .gallery-overlay-btn, .masonry-item:focus-within .gallery-overlay-btn{ transform:translateY(0); opacity:1; }

  /* Pestañas de filtro (subcategorías) */
  .filter-pill{ border:1px solid rgba(185,172,151,.25); color:#B9AC97; transition: all .25s ease; }
  .filter-pill:hover{ color:#F1E8D9; border-color:rgba(201,162,75,.45); }
  .filter-pill.is-active{ background:#C9A24B; color:#15110D; border-color:#C9A24B; }

  /* =====================================================================
     LIGHTBOX (visor de obra ampliada)
     ===================================================================== */
  #lightbox{ transition: opacity .4s ease, visibility .4s ease; }
  #lightbox.is-open{ opacity:1; visibility:visible; }
  #lightbox:not(.is-open){ opacity:0; visibility:hidden; pointer-events:none; }
  #lightbox-stage{ transition: transform .45s cubic-bezier(.16,1,.3,1), opacity .35s ease; }

  /* =====================================================================
     BOTÓN FLOTANTE DE WHATSAPP
     ===================================================================== */
  #wa-float{ animation: waBounce 3.2s ease-in-out infinite; }
  @keyframes waBounce{ 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(-8px);} }
  .wa-ring{ animation: waPulse 2.6s ease-out infinite; }
  @keyframes waPulse{ 0%{ transform:scale(.85); opacity:.55; } 100%{ transform:scale(1.9); opacity:0; } }

  /* Accesibilidad: foco visible consistente en todo el sitio */
  a:focus-visible, button:focus-visible{ outline:2px solid #E3C572; outline-offset:3px; border-radius:2px; }

  /* Respeta la preferencia de "reducir movimiento" del usuario */
  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; scroll-behavior:auto !important; }
  }

  /* Scrollbar discreta acorde a la paleta */
  ::-webkit-scrollbar{ width:10px; }
  ::-webkit-scrollbar-track{ background:#15110D; }
  ::-webkit-scrollbar-thumb{ background:#2A2118; border-radius:8px; border:2px solid #15110D; }
</style>
</head>

