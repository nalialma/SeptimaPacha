      lightbox_close:"Close", lightbox_prev:"Previous", lightbox_next:"Next", menu_open:"Open menu", menu_close:"Close menu", lang_label:"Language",
      wa_generic:"Hi! I'd like to order a portrait. Could you tell me more?",
      wa_template:"Hi! I'm interested in this piece: {title} ({technique}). Could you give me a quote and turnaround time?"
    },
    es: {
      nav_home:"Inicio", nav_about:"Estudio", nav_process:"Proceso", nav_gallery_a:"Mascotas", nav_gallery_b:"Personas", nav_contact:"Contacto",
      header_cta:"Escribir por WhatsApp",
      splash_tagline:"Abriendo la galería…",
      hero_eyebrow:"Estudio de retratos · Polonia",
      hero_title:"Tus recuerdos, <em class=\"italic text-goldlight\">pintados</em> a mano.",
      hero_subtitle:"Convierto fotos de mascotas y seres queridos en obras únicas — pintadas sobre madera, dibujadas a lápiz o reinterpretadas como caricatura. Cada pieza se crea desde cero, en un único ejemplar original.",
      hero_cta_primary:"Encarga tu retrato", hero_cta_secondary:"Ver la galería",
      about_eyebrow:"Sobre el estudio",
      about_title:"Una mano, un ojo <em class=\"italic text-goldlight\">y algo de tiempo</em>.",
      about_text:"Cada retrato empieza con una foto cualquiera — y decenas de horas de trabajo. Pinto sobre tablas de tilo, dibujo con grafito y trazo caricaturas con humor y cariño. Sin impresiones ni copias: solo una pieza original, enviada con cuidado a cualquier punto de Polonia.",
      process_eyebrow:"Cómo funciona", process_title:"Tres pasos hacia tu obra",
      process_step1_title:"Envía una foto", process_step1_text:"Envíame tu foto favorita de tu mascota o de un ser querido por WhatsApp — cuanto más nítida, mejor.",
      process_step2_title:"Elige una técnica", process_step2_text:"Juntos elegimos la forma adecuada: pintura sobre madera, dibujo a lápiz o caricatura en blanco y negro o a color.",
      process_step3_title:"Recibe tu obra", process_step3_text:"Creo el retrato a mano, compartiendo el progreso en el camino, y lo empaco y envío con cuidado hasta ti.",
      cat_a_eyebrow:"Capítulo I", cat_a_title:"Retratos de Mascotas", cat_a_subtitle:"Perros, gatos y otros héroes de cuatro patas, retratados con cariño y atención al detalle.",
      cat_b_eyebrow:"Capítulo II", cat_b_title:"Retratos de Personas", cat_b_subtitle:"Retratos de las personas que quieres — del dibujo realista a la caricatura más divertida.",
      filter_all:"Todas", subcat_wood:"Pintura sobre madera", subcat_pencil:"Dibujo a lápiz", subcat_bw:"Caricatura B/N", subcat_color:"Caricatura a color",
      card_cta:"Pedir cotización", lightbox_cta:"Encargar esta obra", gallery_empty:"Pronto más ejemplos en esta categoría.", piece_label:"Obra",
      final_cta_eyebrow:"Invitación", final_cta_title:"Creemos algo <em class=\"italic text-goldlight\">que perdure</em>.",
      final_cta_subtitle:"Escríbeme ahora, cuéntame tu idea y recibe una cotización gratuita en minutos.", final_cta_button:"Escribir por WhatsApp",
      footer_nav_title:"Navegación", footer_contact_title:"Contacto", footer_follow_title:"Síguenos", footer_rights:"Todos los derechos reservados.", footer_made:"Hecho a mano en Polonia.",
      lightbox_close:"Cerrar", lightbox_prev:"Anterior", lightbox_next:"Siguiente", menu_open:"Abrir menú", menu_close:"Cerrar menú", lang_label:"Idioma",
      wa_generic:"¡Hola! Quiero encargar un retrato. ¿Podrías darme más información?",
      wa_template:"¡Hola! Me interesa esta obra: {title} ({technique}). ¿Podrías indicarme el precio y el tiempo de entrega?"
    }
  };

  let currentLang = "pl"; // idioma por defecto: polaco

  /* ===================================================================
     C) FUNCIONES DE WHATSAPP
     =================================================================== */
  function waLink(message){
    return "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent(message);
  }

  function updateGenericWaLinks(){
    const msg = translations[currentLang].wa_generic;
    document.querySelectorAll(".js-wa-generic").forEach(function(el){
      el.setAttribute("href", waLink(msg));
    });
  }

  function buildPieceMessage(title, technique){
    return translations[currentLang].wa_template
      .replace("{title}", title)
      .replace("{technique}", technique);
  }

  /* ===================================================================
     D) SISTEMA DE IDIOMAS (i18n)
     =================================================================== */
  function applyLanguage(lang){
    currentLang = translations[lang] ? lang : "pl";
    const t = translations[currentLang];

    // Texto simple (textContent)
    document.querySelectorAll("[data-i18n]").forEach(function(el){
      const key = el.getAttribute("data-i18n");
      if (t[key] !== undefined) el.textContent = t[key];
    });

    // Texto con marcado HTML simple (ej. <em> para énfasis)
    document.querySelectorAll("[data-i18n-html]").forEach(function(el){
      const key = el.getAttribute("data-i18n-html");
      if (t[key] !== undefined) el.innerHTML = t[key];
    });

    document.documentElement.setAttribute("lang", currentLang);

    // Resalta el botón de idioma activo
    document.querySelectorAll(".lang-pill").forEach(function(btn){
      btn.classList.toggle("is-active", btn.getAttribute("data-lang") === currentLang);
    });

    updateGenericWaLinks();
    renderMarquee();
    renderFilters("a"); renderFilters("b");
    renderGrid("a"); renderGrid("b");
  }

  document.querySelectorAll(".lang-switch [data-lang], #mobile-nav [data-lang]").forEach(function(btn){
    btn.addEventListener("click", function(){ applyLanguage(btn.getAttribute("data-lang")); });
  });

  /* ===================================================================
     E) MARQUESINA DE TÉCNICAS (hero) — generada a partir de las traducciones
     =================================================================== */
  function renderMarquee(){
    const t = translations[currentLang];
    const words = [t.subcat_wood, t.subcat_pencil, t.subcat_bw, t.subcat_color, t.cat_a_title, t.cat_b_title];
    const track = document.getElementById("marquee-track");
    if (!track) return;
    // Se duplica la lista para lograr el efecto de bucle infinito sin saltos
    const itemsHtml = words.concat(words).map(function(w){
      return '<span class="flex items-center gap-10">' + w + '<span class="text-gold">&#10022;</span></span>';
    }).join("");
    track.innerHTML = itemsHtml;
  }

  /* ===================================================================
     F) ESTADO DE FILTROS Y RENDERIZADO DE GALERÍAS
     =================================================================== */
  const activeFilter = { a: "all", b: "all" };

  function renderFilters(catKey){
    const t = translations[currentLang];
    const container = document.getElementById("filters-" + catKey);
    if (!container) return;

    const labels = { all: t.filter_all, wood: t.subcat_wood, pencil: t.subcat_pencil, bw: t.subcat_bw, color: t.subcat_color };
    const options = ["all"].concat(SUBCATS);

    container.innerHTML = options.map(function(key){
      const active = activeFilter[catKey] === key ? " is-active" : "";
      return '<button type="button" data-filter="' + key + '" class="filter-pill px-4 py-2 rounded-full font-mono text-[11px] uppercase tracking-wider' + active + '">' + labels[key] + '</button>';
    }).join("");

    container.querySelectorAll("[data-filter]").forEach(function(btn){
      btn.addEventListener("click", function(){
        activeFilter[catKey] = btn.getAttribute("data-filter");
        renderFilters(catKey);
        renderGrid(catKey);
      });
    });
  }

  function renderGrid(catKey){
    const t = translations[currentLang];
    const grid = document.getElementById("grid-" + catKey);
    const emptyMsg = document.getElementById("empty-" + catKey);
    if (!grid) return;

    const items = galleryData[catKey];
    const filter = activeFilter[catKey];
    const techniqueLabels = { wood: t.subcat_wood, pencil: t.subcat_pencil, bw: t.subcat_bw, color: t.subcat_color };
    const catLabel = catKey === "a" ? t.cat_a_title : t.cat_b_title;

    let visibleCount = 0;
    grid.innerHTML = items.map(function(item, index){
      const isVisible = (filter === "all" || filter === item.subcat);
      if (isVisible) visibleCount++;
      const technique = techniqueLabels[item.subcat];
      const title = t.piece_label + " " + String(index + 1).padStart(2, "0");
      const altText = title + " — " + technique + " — " + catLabel;

      return ''
        + '<figure class="masonry-item' + (isVisible ? '' : ' is-hidden') + '" data-cat="' + catKey + '" data-index="' + index + '">'
        +   '<div class="frame-corners relative overflow-hidden rounded-sm cursor-pointer" tabindex="0" role="button" aria-label="' + altText + '">'
        +     '<span class="fc-tr"></span><span class="fc-bl"></span>'
        +     '<img src="' + item.src + '" alt="' + altText + '" loading="lazy" decoding="async" class="w-full h-auto block">'
        +     '<div class="gallery-overlay absolute inset-0 flex items-end p-4">'
        +       '<button type="button" class="gallery-overlay-btn quote-btn btn-gold w-full px-4 py-2.5 rounded-sm font-mono text-[10px] uppercase tracking-wider">' + t.card_cta + '</button>'
        +     '</div>'
        +   '</div>'
        +   '<figcaption class="placard mt-3 flex items-center justify-between font-mono text-[10px] uppercase tracking-widest text-bonedim">'
        +     '<span class="text-bone">' + title + '</span><span class="text-gold">' + technique + '</span>'
        +   '</figcaption>'
        + '</figure>';
    }).join("");

    // Abrir el lightbox al hacer clic/tap o pulsar Enter sobre la imagen
    grid.querySelectorAll(".masonry-item").forEach(function(fig){
      const stage = fig.querySelector(".frame-corners");
      const openHandler = function(){
        openLightbox(catKey, parseInt(fig.getAttribute("data-index"), 10));
      };
      stage.addEventListener("click", openHandler);
      stage.addEventListener("keydown", function(e){ if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openHandler(); } });
    });

    // Botón "pedir cotización" sobre cada tarjeta -> WhatsApp directo (sin abrir el lightbox)
    grid.querySelectorAll(".quote-btn").forEach(function(btn, i){
      btn.addEventListener("click", function(e){
        e.stopPropagation();
        const item = items[i];
        const technique = techniqueLabels[item.subcat];
        const title = t.piece_label + " " + String(i + 1).padStart(2, "0");
        window.open(waLink(buildPieceMessage(title, technique)), "_blank", "noopener");
      });
    });

    if (emptyMsg) emptyMsg.classList.toggle("hidden", visibleCount !== 0);
  }

  /* ===================================================================
     G) LIGHTBOX (visor ampliado de la obra)
     =================================================================== */
  const lightbox = document.getElementById("lightbox");
  const lbImg = document.getElementById("lightbox-img");
  const lbTitle = document.getElementById("lightbox-title");
  const lbTechnique = document.getElementById("lightbox-technique");
  const lbCta = document.getElementById("lightbox-cta");
  let lbState = { cat: "a", index: 0 };

  function openLightbox(catKey, index){
    lbState = { cat: catKey, index: index };
    fillLightbox();
    lightbox.classList.add("is-open");
    document.body.classList.add("no-scroll");
  }

  function closeLightbox(){
    lightbox.classList.remove("is-open");
    document.body.classList.remove("no-scroll");
  }

  function fillLightbox(){
    const t = translations[currentLang];
    const items = galleryData[lbState.cat];
    const item = items[lbState.index];
    const techniqueLabels = { wood: t.subcat_wood, pencil: t.subcat_pencil, bw: t.subcat_bw, color: t.subcat_color };
    const technique = techniqueLabels[item.subcat];
    const title = t.piece_label + " " + String(lbState.index + 1).padStart(2, "0");

    lbImg.src = item.src;
    lbImg.alt = title + " — " + technique;
    lbTitle.textContent = title;
    lbTechnique.textContent = technique;
    lbCta.setAttribute("href", waLink(buildPieceMessage(title, technique)));
  }

  function stepLightbox(delta){
    const items = galleryData[lbState.cat];
    lbState.index = (lbState.index + delta + items.length) % items.length;
    fillLightbox();
  }

  document.getElementById("lightbox-close").addEventListener("click", closeLightbox);
  document.getElementById("lightbox-prev").addEventListener("click", function(){ stepLightbox(-1); });
  document.getElementById("lightbox-next").addEventListener("click", function(){ stepLightbox(1); });
  lightbox.addEventListener("click", function(e){ if (e.target === lightbox) closeLightbox(); });
  document.addEventListener("keydown", function(e){
    if (!lightbox.classList.contains("is-open")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") stepLightbox(-1);
    if (e.key === "ArrowRight") stepLightbox(1);
  });

  /* ===================================================================
     H) CABECERA: efecto al hacer scroll + menú móvil
     =================================================================== */
  const header = document.getElementById("site-header");
  function onScroll(){
    if (window.scrollY > 30) header.classList.add("scrolled");
    else header.classList.remove("scrolled");
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const mobileNav = document.getElementById("mobile-nav");
  const menuToggle = document.getElementById("menu-toggle");
  const menuClose = document.getElementById("menu-close");

  function openMobileNav(){
    mobileNav.classList.add("is-open");
    document.body.classList.add("no-scroll");
    menuToggle.setAttribute("aria-expanded", "true");
  }
  function closeMobileNav(){
    mobileNav.classList.remove("is-open");
    if (!lightbox.classList.contains("is-open")) document.body.classList.remove("no-scroll");
    menuToggle.setAttribute("aria-expanded", "false");
  }
  menuToggle.addEventListener("click", openMobileNav);
  menuClose.addEventListener("click", closeMobileNav);
  mobileNav.querySelectorAll("a").forEach(function(a){ a.addEventListener("click", closeMobileNav); });

  /* ===================================================================
     I) RESPLANDOR DEL HERO QUE SIGUE AL CURSOR (efecto "foco de galería")
     =================================================================== */
  const heroSection = document.getElementById("home");
  if (window.matchMedia("(pointer: fine)").matches){
    heroSection.addEventListener("mousemove", function(e){
      const rect = heroSection.getBoundingClientRect();
      const mx = ((e.clientX - rect.left) / rect.width) * 100;
      const my = ((e.clientY - rect.top) / rect.height) * 100;
      heroSection.style.setProperty("--mx", mx + "%");
      heroSection.style.setProperty("--my", my + "%");
    });

    // Pequeño efecto de inclinación 3D sobre la obra flotante del hero
    const heroFrame = document.querySelector(".hero-frame");
    if (heroFrame){
      heroSection.addEventListener("mousemove", function(e){
        const rect = heroFrame.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const rotateY = ((e.clientX - cx) / rect.width) * 8;
        const rotateX = -((e.clientY - cy) / rect.height) * 8;
        heroFrame.style.transform = "perspective(900px) rotateX(" + rotateX + "deg) rotateY(" + rotateY + "deg)";
      });
      heroSection.addEventListener("mouseleave", function(){ heroFrame.style.transform = ""; });
    }
  }

  /* ===================================================================
     J) REVELADO DE SECCIONES AL HACER SCROLL (IntersectionObserver)
     =================================================================== */
  const revealObserver = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting){
        entry.target.classList.add("is-visible");
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: "0px 0px -60px 0px" });

  function observeReveals(){
    document.querySelectorAll(".reveal:not(.is-visible)").forEach(function(el){ revealObserver.observe(el); });
  }

  /* ===================================================================
     K) MARCADO ACTIVO DE NAVEGACIÓN SEGÚN LA SECCIÓN VISIBLE
     =================================================================== */
  const sections = document.querySelectorAll("main section[id]");
  const navLinks = document.querySelectorAll('.nav-link[href^="#"]');
  const navObserver = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting){
        navLinks.forEach(function(link){
          link.classList.toggle("is-active", link.getAttribute("href") === "#" + entry.target.id);
        });
      }
    });
  }, { threshold: 0.5 });
  sections.forEach(function(s){ navObserver.observe(s); });

  /* ===================================================================
     L) AÑO DEL FOOTER
     =================================================================== */
  document.getElementById("footer-year").textContent = new Date().getFullYear();

  /* ===================================================================
     M) SPLASH SCREEN — temporizador de bienvenida
     =================================================================== */
  const splash = document.getElementById("splash");
  function hideSplash(){
    splash.classList.add("splash-hide");
    document.body.classList.remove("no-scroll");
    observeReveals();
  }

  /* ===================================================================
     N) INICIALIZACIÓN GENERAL
     =================================================================== */
  applyLanguage("pl"); // Polaco como idioma principal por defecto

  // El splash se muestra un mínimo de tiempo para que la animación se aprecie,
  // y desaparece tanto si la página ya cargó como, como máximo, tras 2.6s.
  let pageLoaded = false;
  window.addEventListener("load", function(){ pageLoaded = true; });
  setTimeout(function(){ hideSplash(); }, 2600);

})();
</script>
